# Local mode reads GEMINI_API_KEY from the environment or .env.
GEMINI_API_KEY=
# optional
SPIDER_MODEL=gemini-3.1-flash-lite
PORT=8765
# Public hosting requires the Language Engine bridge and durable budget state.
# SEARCHSPIDER_PUBLIC=1
# SEARCHSPIDER_BRIDGE_SECRET=generate-a-random-secret-of-at-least-32-characters
# SEARCHSPIDER_STATE_DB=/var/lib/searchspider/access.sqlite3
